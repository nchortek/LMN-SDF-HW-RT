#version 460
#extension GL_EXT_ray_tracing : require
#extension GL_GOOGLE_include_directive : require

#include "gpu/shared.h"
#include "common.glsl"
#include "sdf_voxel.glsl"

// This shader handles intersections with SDF bricks via DDA,
// currently reporting hits against voxel AABBs

layout(push_constant, scalar) uniform PushConstantBlock
{
    PushConstants pc;
};

const int kMaxVoxelsVisited = 1 + 3 * (int(BRICK_VOXELS) - 1);
const float kDDAMiss = 1e30;

// Copied over from pruning/common.glsl
// 
// NCHORTEK TODO: We should tidy up the code base after M2 and reorganize
// things to avoid code duplication and ensure proper object-oriented
// design principles.
// 
// For example: All of the morton helpers could go in a dedicated (and small) 
// morton.glsl file that the other shaders include as needed.
//
// https://fgiesen.wordpress.com/2009/12/13/decoding-morton-codes/
uint compact1By2(uint x)
{
    x &= 0x09249249u;
    x = (x ^ (x >> 2)) & 0x030c30c3u;
    x = (x ^ (x >> 4)) & 0x0300f00fu;
    x = (x ^ (x >> 8)) & 0xff0000ffu;
    x = (x ^ (x >> 16)) & 0x000003ffu;
    return x;
}

uvec3 mortonDecode(uint morton)
{
    return uvec3(compact1By2(morton),
        compact1By2(morton >> 1),
        compact1By2(morton >> 2));
}

void main()
{
    SceneAddresses sceneAddresses = SceneAddressesBuffer(pc.sceneAddr).deviceAddresses;
    SdfSceneAddresses sdfAddresses = SdfSceneAddressesBuffer(sceneAddresses.sdfAddr).sdfDeviceAddresses;

    // Calculate the brick's full length per axis
    float brickSideLen = float(BRICK_VOXELS) * sdfAddresses.voxelSize;

    // gl_PrimitiveID is the brick index which we use to index into
    // the parallel buffers containing brick data.
    // 
    // A brick's morton code stores the brick's grid indices
    // (i.e. its integer XYZ coordinates into the 3D grid of bricks)
    uint morton = MortonBuffer(sdfAddresses.mortonsAddr).mortons[gl_PrimitiveID];

    // Use the brick grid indices to define the brick's total span in object space
    // (this can be larger than the tight bounding box we intersect against)
    vec3 brickMin = sdfAddresses.domainMin + vec3(mortonDecode(morton)) * brickSideLen;
    vec3 brickMax = brickMin + vec3(brickSideLen);

    // Slab test in object space
    vec3 invDir = 1.0 / gl_ObjectRayDirectionEXT;
    vec3 t0 = (brickMin - gl_ObjectRayOriginEXT) * invDir;
    vec3 t1 = (brickMax - gl_ObjectRayOriginEXT) * invDir;
    vec3 tNear = min(t0, t1);
    vec3 tFar = max(t0, t1);

    // This is the furthest t-values for which the ray enters any slab,
    // which is the same as saying "this t-value is where we enter the brick"
    float tEnter = max(max(tNear.x, tNear.y), tNear.z);

    // This is the closest t-value for which the ray leaves any slab,
    // which is the same as saying "this t-value is where we exit the brick"
    float tExit = min(min(tFar.x, tFar.y), tFar.z);

    // Clamp the ray to be inside the brick and within [tMin, tMax]
    // 
    // Fun fact: gl_RayTmaxEXT starts with the value specified by traceRayEXT,
    // but is updated to be min(hitT, gl_RayTmaxEXT) whenever a valid hit is
    // reported for a given ray
    float tStart = max(tEnter, gl_RayTminEXT);
    float tEnd = min(tExit, gl_RayTmaxEXT);

    if (tStart > tEnd)
    {
        return;
    }

    // The ray enters through the slab whose near plane it crosses last
    // (entryAxis == 0 for x, 1 for y, and 2 for z)
    uint entryAxis = (tNear.x > tNear.y)
        ? ((tNear.x > tNear.z) ? 0u : 2u)
        : ((tNear.y > tNear.z) ? 1u : 2u);

    // Compute the ray position and direction in a brick-local space spanning 
    // [0, BRICK_VOXELS] in each axis
    vec3 brickLocalRayDir = gl_ObjectRayDirectionEXT / sdfAddresses.voxelSize;
    vec3 brickLocalRayPos = gl_ObjectRayOriginEXT + tStart * gl_ObjectRayDirectionEXT;
    brickLocalRayPos -= brickMin;
    brickLocalRayPos /= sdfAddresses.voxelSize;

    // Compute the voxel index in brick-local space (integer coords in [0, BRICK_VOXELS - 1])
    ivec3 localVoxelIdx = clamp(
        ivec3(floor(brickLocalRayPos)),
        0,
        int(BRICK_VOXELS) - 1);

    // Convert the ray direction into index space (integer coords in [-1, 0, 1])
    ivec3 gridStepDir = ivec3(sign(brickLocalRayDir));

    // Compute the brick-local coordinates that describe where the ray
    // will next cross a voxel boundary along each axis
    vec3 nextLocalVoxelBoundary = vec3(localVoxelIdx + max(gridStepDir, 0));

    // Solve for the t value at which the ray crosses the next voxel boundary along each axis
    vec3 tNext = vec3(tStart) + ((nextLocalVoxelBoundary - brickLocalRayPos) / brickLocalRayDir);

    // For ray components with no movement, replace the garbage t value with our DDAMiss sentinel
    tNext = mix(tNext, vec3(kDDAMiss), equal(gridStepDir, ivec3(0)));

    // Compute the t value needed to traverse one full voxel along each axis
    vec3 tDelta = abs(1.0 / brickLocalRayDir);

    float tVoxelEnter = tStart;

    for (int i = 0; i < kMaxVoxelsVisited; i++)
    {
        float voxelSamples[8] = getVoxelSamples(
            sdfAddresses.samplesAddr,
            uint(gl_PrimitiveID),
            uvec3(localVoxelIdx),
            sdfAddresses.band);

        float minVoxelSample = voxelSamples[0];
        for (int j = 1; j < 8; j++)
        {
            minVoxelSample = min(minVoxelSample, voxelSamples[j]);
        }

        // A voxel with a sample inside (or on) the surface is a hit
        if (minVoxelSample <= 0.0)
        {
            // A ray moving along the positive axis direction enters through the min face.
            // This allows us to set the hit kind to the entered face:
            // 0: +x, 1: -x, 2: +y, 3: -y, 4: +z, 5: -z
            uint face = (2u * entryAxis) + ((gl_ObjectRayDirectionEXT[entryAxis] > 0.0) ? 1u : 0u);
            reportIntersectionEXT(tVoxelEnter, face);
            return;
        }

        // If the next voxel is out of range, return without reporting a hit
        float tVoxelExit = min(min(tNext.x, tNext.y), tNext.z);
        if (tVoxelExit >= tEnd)
        {
            return;
        }

        // Step into the neighboring voxel across the nearest voxel boundary
        uint crossingAxis = (tNext.x < tNext.y)
            ? ((tNext.x < tNext.z) ? 0u : 2u)
            : ((tNext.y < tNext.z) ? 1u : 2u);

        localVoxelIdx[crossingAxis] += gridStepDir[crossingAxis];

        // Return without reporting a hit if we leave the brick
        if (localVoxelIdx[crossingAxis] < 0
            || localVoxelIdx[crossingAxis] >= int(BRICK_VOXELS))
        {
            return;
        }

        tVoxelEnter = tNext[crossingAxis];
        tNext[crossingAxis] += tDelta[crossingAxis];
        entryAxis = crossingAxis;
    }
}
