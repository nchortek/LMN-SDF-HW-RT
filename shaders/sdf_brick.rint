#version 460
#extension GL_EXT_ray_tracing : require
#extension GL_GOOGLE_include_directive : require

#include "gpu/shared.h"
#include "common.glsl"
#include "sdf_voxel.glsl"

// This shader handles intersections with SDF bricks via DDA, traversing the
// voxels of a given brick and checking for hits by trilinearly interpolating
// each voxel's 8 corner samples via the methods described in Soderlund et al 2022

layout(push_constant, scalar) uniform PushConstantBlock
{
    PushConstants pc;
};

// This gets passed to the SDF closest hit shader alongside the t-value of an intersection
hitAttributeEXT SdfHitAttributes hitAttributes;

const uint kMaxVoxelsVisited = 1u + 3u * (BRICK_VOXELS - 1u);
const float kDDAMiss = 1e30;
const float kVoxelLocalRootEpsilon = 4e-3;
const int kMaxRootInterpolationSteps = 50;

// Evaluate the cubic polynomical with coefficents c at value t
float evalCubic(vec4 c, float t)
{
    return (((((c.w * t) + c.z) * t) + c.y) * t) + c.x;
}

// Given a voxel's samples, the ray origin, and the ray direction,
// compute the coefficients for the cubic polynomial from Soderlund et al 2022
//
// Note that o must be in voxel-local space ([0, 1] along each axis), and
// d is expressed in voxels per t
//
// Adapted from Soderlund et al 2022, Eqs. 3-7
vec4 computeCubicCoefficients(float samples[8], vec3 o, vec3 d)
{
    float a = samples[5] - samples[4];

    float k0 = samples[0];
    float k1 = samples[1] - samples[0];
    float k2 = samples[2] - samples[0];
    float k3 = samples[3] - samples[2] - k1;
    float k4 = k0 - samples[4];
    float k5 = k1 - a;
    float k6 = k2 - (samples[6] - samples[4]);
    float k7 = k3 - (samples[7] - samples[6] - a);

    float m0 = o.x * o.y;
    float m1 = d.x * d.y;
    float m2 = (o.x * d.y) + (o.y * d.x);
    float m3 = (k5 * o.z) - k1;
    float m4 = (k6 * o.z) - k2;
    float m5 = (k7 * o.z) - k3;

    float c0 = ((k4 * o.z) - k0)
        + (o.x * m3)
        + (o.y * m4)
        + (m0 * m5);

    float c1 = (d.x * m3)
        + (d.y * m4)
        + (m2 * m5)
        + (d.z
            * (k4
                + (k5 * o.x)
                + (k6 * o.y)
                + (k7 * m0)));

    float c2 = (m1 * m5)
        + (d.z
            * ((k5 * d.x)
                + (k6 * d.y)
                + (k7 * m2)));

    float c3 = k7 * m1 * d.z;

    // Negate the coefficients before returning so a negative value
    // marks the interior of the SDF
    return -vec4(c0, c1, c2, c3);
}

// Given the coefficients of a cubic polynomial, return the t values
// in the exclusive range (0, tFar) corresponding to the roots of its quadratic
// derivative.
//
// The roots are returned in increasing order, with tFar indicating
// a non-existant root
//
// Adapted from Marmitt et al 2004, Alg. 3
vec2 computeIntervalSplitPoints(vec4 c, float tFar)
{
    // Calculate the quadratic coefficients
    vec3 q = vec3(c.y, 2.0 * c.z, 3.0 * c.w);
    vec2 roots = vec2(tFar);

    if (q.z == 0.0
        && q.y != 0.0)
    {
        // If the derivative is actually linear we can solve directly for
        // its single root
        roots.x = -q.x / q.y;
    }
    else
    {
        // The derivative is indeed a quadratic equation, so safely compute its roots
        // https://stackoverflow.com/questions/48979861/numerically-stable-method-for-solving-quadratic-equations
        float discriminant = (q.y * q.y) - (4.0 * q.z * q.x);
        if (discriminant > 0.0)
        {
            float copySign = (q.y >= 0.0) ? 1.0 : -1.0;
            float tmp = -0.5 * (q.y + (copySign * sqrt(discriminant)));
            roots = vec2(tmp / q.z, q.x / tmp);
        }
    }

    // Discard roots outside the exclusive (0, tFar) range
    roots = mix(roots, vec2(tFar), lessThanEqual(roots, vec2(0.0)));
    roots = min(roots, vec2(tFar));

    // Return the split points in increasing order
    return vec2(min(roots.x, roots.y), max(roots.x, roots.y));
}

// Given the coefficients of a cubic polynomial, find the first root in the
// range of [0, tFar] for which the polynomial transitions from non-negative
// to negative (i.e. the first t value for which the ray enters the surface).
//
// Returns whether or not a root (and therefore an intersection) was found
//
// Adapted from Marmitt et al 2004, Alg. 3
bool findEnteringRoot(vec4 c, float tFar, float epsilon, bool dontComputeT, out float t)
{
    vec2 intervalSplitPoints = computeIntervalSplitPoints(c, tFar);
    vec3 subintervalEnds = vec3(intervalSplitPoints, tFar);

    float t0 = 0.0;
    float g0 = c.x;

    for (uint i = 0u; i < 3u; i++)
    {
        float t1 = subintervalEnds[i];
        float g1 = evalCubic(c, t1);

        if (g0 >= 0.0
            && g1 < 0.0)
        {
            // Now that we found an interval [t0, t1] that contains an entering root,
            // we optionally perform repeated linear interpolation to find the exact t
            t = t0;

            if (dontComputeT)
            {
                return true;
            }

            for (uint j = 0u; j < kMaxRootInterpolationSteps; j++)
            {
                float tPrev = t;

                // Lerp between t0 and t1 with a blend factor equal to the fraction of
                // the interval marking where the line through (t0, g0) and (t1, g1)
                // crosses zero
                t = mix(t0, t1, g0 / (g0 - g1));

                // t now holds our current "best assessment" of the intersection point.
                // We can now evaluate our cubic polynomial at that point in order to
                // narrow our interval
                float newG = evalCubic(c, t);

                if (newG >= 0.0)
                {
                    t0 = t;
                    g0 = newG;
                }
                else
                {
                    t1 = t;
                    g1 = newG;
                }

                if (abs(t - tPrev) < epsilon)
                {
                    break;
                }
            }

            return true;
        }

        t0 = t1;
        g0 = g1;
    }

    t = tFar;
    return false;
}

// Copied over from pruning/common.glsl
// 
// NCHORTEK TODO: We should tidy up the code base after M2 and reorganize
// things to avoid code duplication and ensure proper object-oriented
// design principles.
// 
// For example: All of the morton helpers could go in a dedicated (and small) 
// morton.glsl file that the other shaders include as needed.
//
// https://fgiesen.wordpress.com/2009/12/13/decoding-morton-codes/
uint compact1By2(uint x)
{
    x &= 0x09249249u;
    x = (x ^ (x >> 2)) & 0x030c30c3u;
    x = (x ^ (x >> 4)) & 0x0300f00fu;
    x = (x ^ (x >> 8)) & 0xff0000ffu;
    x = (x ^ (x >> 16)) & 0x000003ffu;
    return x;
}

uvec3 mortonDecode(uint morton)
{
    return uvec3(compact1By2(morton),
        compact1By2(morton >> 1),
        compact1By2(morton >> 2));
}

void main()
{
    SceneAddresses sceneAddresses = SceneAddressesBuffer(pc.sceneAddr).deviceAddresses;
    SdfSceneAddresses sdfAddresses = SdfSceneAddressesBuffer(sceneAddresses.sdfAddr).sdfDeviceAddresses;

    // Calculate the brick's full length per axis
    float brickSideLen = float(BRICK_VOXELS) * sdfAddresses.voxelSize;

    // gl_PrimitiveID is the brick index which we use to index into
    // the parallel buffers containing brick data.
    // 
    // A brick's morton code stores the brick's grid indices
    // (i.e. its integer XYZ coordinates into the 3D grid of bricks)
    uint morton = MortonBuffer(sdfAddresses.mortonsAddr).mortons[gl_PrimitiveID];

    // Use the brick grid indices to define the brick's total span in object space
    // (this can be larger than the tight bounding box we intersect against)
    vec3 brickMin = sdfAddresses.domainMin + vec3(mortonDecode(morton)) * brickSideLen;
    vec3 brickMax = brickMin + vec3(brickSideLen);

    // Slab test in object space
    vec3 invDir = 1.0 / gl_ObjectRayDirectionEXT;
    vec3 t0 = (brickMin - gl_ObjectRayOriginEXT) * invDir;
    vec3 t1 = (brickMax - gl_ObjectRayOriginEXT) * invDir;
    vec3 tNear = min(t0, t1);
    vec3 tFar = max(t0, t1);

    // This is the furthest t-values for which the ray enters any slab,
    // which is the same as saying "this t-value is where we enter the brick"
    float tEnter = max(max(tNear.x, tNear.y), tNear.z);

    // This is the closest t-value for which the ray leaves any slab,
    // which is the same as saying "this t-value is where we exit the brick"
    float tExit = min(min(tFar.x, tFar.y), tFar.z);

    // Clamp the ray to be inside the brick and within [tMin, tMax]
    // 
    // Fun fact: gl_RayTmaxEXT starts with the value specified by traceRayEXT,
    // but is updated to be min(hitT, gl_RayTmaxEXT) whenever a valid hit is
    // reported for a given ray
    float tStart = max(tEnter, gl_RayTminEXT);
    float tEnd = min(tExit, gl_RayTmaxEXT);

    if (tStart > tEnd)
    {
        return;
    }

    // Compute the ray position and direction in a brick-local space spanning 
    // [0, BRICK_VOXELS] in each axis
    vec3 brickLocalRayDir = gl_ObjectRayDirectionEXT / sdfAddresses.voxelSize;
    vec3 brickLocalRayPos = gl_ObjectRayOriginEXT + tStart * gl_ObjectRayDirectionEXT;
    brickLocalRayPos -= brickMin;
    brickLocalRayPos /= sdfAddresses.voxelSize;

    // Compute the voxel index in brick-local space (integer coords in [0, BRICK_VOXELS - 1])
    ivec3 brickLocalVoxelIdx = clamp(
        ivec3(floor(brickLocalRayPos)),
        0,
        int(BRICK_VOXELS) - 1);

    // Convert the ray direction into index space (integer coords in [-1, 0, 1])
    ivec3 gridStepDir = ivec3(sign(brickLocalRayDir));

    // Compute the brick-local coordinates that describe where the ray
    // will next cross a voxel boundary along each axis
    vec3 nextLocalVoxelBoundary = vec3(brickLocalVoxelIdx + max(gridStepDir, 0));

    // Solve for the t value at which the ray crosses the next voxel boundary along each axis
    vec3 tNext = vec3(tStart) + ((nextLocalVoxelBoundary - brickLocalRayPos) / brickLocalRayDir);

    // For ray components with no movement, replace the garbage t value with our DDAMiss sentinel
    tNext = mix(tNext, vec3(kDDAMiss), equal(gridStepDir, ivec3(0)));

    // Compute the t value needed to traverse one full voxel along each axis
    vec3 tDelta = abs(1.0 / brickLocalRayDir);

    bool doSolidFaceTest = (pc.flags & kFlagSolidFaceTest) != 0u;
    bool rayWasOutsideSurface = (tEnter >= gl_RayTminEXT);
    bool isShadowRay = (gl_IncomingRayFlagsEXT & gl_RayFlagsTerminateOnFirstHitEXT) != 0u;
    float rootEpsilonT = kVoxelLocalRootEpsilon / length(brickLocalRayDir);
    float tVoxelEnter = tStart;

    for (uint i = 0u; i < kMaxVoxelsVisited; i++)
    {
        float tVoxelExit = min(min(tNext.x, tNext.y), tNext.z);
        float voxelSamples[8] = getVoxelSamples(
            sdfAddresses.samplesAddr,
            uint(gl_PrimitiveID),
            uvec3(brickLocalVoxelIdx),
            sdfAddresses.band);

        float minVoxelSample = voxelSamples[0];
        for (uint j = 1u; j < 8u; j++)
        {
            minVoxelSample = min(minVoxelSample, voxelSamples[j]);
        }

        // A voxel with a sample inside (or on) the surface needs to
        // be intersection tested
        if (minVoxelSample <= 0.0)
        {
            // Calculate the units of t the ray must traverse to move from
            // the point where it enters a voxel to the point where it exits
            // the voxel (or the ray's maximum t value if that is closer)
            float tToVoxelExit = min(tVoxelExit, tEnd) - tVoxelEnter;

            vec3 voxelLocalRayEntryPos = brickLocalRayPos
                + ((tVoxelEnter - tStart) * brickLocalRayDir)
                - vec3(brickLocalVoxelIdx);
            vec4 c = computeCubicCoefficients(voxelSamples, voxelLocalRayEntryPos, brickLocalRayDir);
            float tIntoVoxel;

            // If the ray was outside the surface just before entering this voxel, but is
            // inside the surface at the point where it enters, then the ray crossed the
            // surface exactly at the shared voxel face, and we report a hit there.
            //
            // This requires special handling, because our root-search intersection
            // test can miss such intersections due to floating point imprecision.
            //
            // c.x is the cubic evaluated at t = 0, which equals Soderlund et al. 2022, Eq. 1 
            // (the trilinearly interpolated f) at the voxel entry point.
            //
            // Adapted from Soderlund et al. 2022, Section 2
            if (doSolidFaceTest 
                && rayWasOutsideSurface
                && c.x < 0.0)
            {
                hitAttributes.packedBrickLocalVoxelIdx = packBrickLocalVoxelIdx(uvec3(brickLocalVoxelIdx));
                hitAttributes.voxelLocalPos = voxelLocalRayEntryPos;
                reportIntersectionEXT(tVoxelEnter, 0u);
                return;
            }

            if (tToVoxelExit > 0.0
                && findEnteringRoot(c, tToVoxelExit, rootEpsilonT, isShadowRay, tIntoVoxel))
            {
                hitAttributes.packedBrickLocalVoxelIdx = packBrickLocalVoxelIdx(uvec3(brickLocalVoxelIdx));
                hitAttributes.voxelLocalPos = voxelLocalRayEntryPos + (tIntoVoxel * brickLocalRayDir);
                reportIntersectionEXT(tVoxelEnter + tIntoVoxel, 0u);
                return;
            }
            
            rayWasOutsideSurface = (evalCubic(c, max(tToVoxelExit, 0.0)) >= 0.0);
        }
        else
        {
            rayWasOutsideSurface = true;
        }

        // If the next voxel is out of range, return without reporting a hit
        if (tVoxelExit >= tEnd)
        {
            return;
        }

        // Step into the neighboring voxel across the nearest voxel boundary
        uint crossingAxis = (tNext.x < tNext.y)
            ? ((tNext.x < tNext.z) ? 0u : 2u)
            : ((tNext.y < tNext.z) ? 1u : 2u);

        brickLocalVoxelIdx[crossingAxis] += gridStepDir[crossingAxis];

        // Return without reporting a hit if we leave the brick
        if (brickLocalVoxelIdx[crossingAxis] < 0
            || brickLocalVoxelIdx[crossingAxis] >= int(BRICK_VOXELS))
        {
            return;
        }

        tVoxelEnter = tNext[crossingAxis];
        tNext[crossingAxis] += tDelta[crossingAxis];
    }
}
